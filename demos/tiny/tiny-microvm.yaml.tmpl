# The micro-VM counterpart of tiny.yaml.tmpl: the same density measurement
# against the other sandbox runtime, so the two are comparable on one axis.
#
# Pinned to the big KVM node (scale-microvm, c3-highmem-44: 44 vCPU, 332GiB).
# atecontroller already constrains a micro-VM pool to nodes labelled
# ate.dev/sandboxClass=microvm and tolerates the matching taint; the extra
# selector below picks the ONE large node out of those, so a packing run does
# not land on a 16GB c3-standard-4 beside other people's demos.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-scale-tiny-microvm

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: tiny-microvm
  namespace: ate-scale-tiny-microvm
  labels:
    workload: tiny-microvm
spec:
  # ONE worker, for the same reason as the gVisor fixture: density is per
  # worker, and a second replica would only split the population.
  replicas: 1
  sandboxClass: microvm
  sandboxConfigName: microvm
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-microvm

  maxActorsPerWorker: 4094

  template:
    nodeSelector:
      substrate-scale: microvm-big

    # Capacity and placement are decoupled the same way tiny.yaml.tmpl explains:
    # workerCapacity reads the LIMITS, the kube-scheduler places by the REQUESTS,
    # and limits are never checked against the node.
    #
    # The memory limit is set from MEASUREMENT, and it is the one number here
    # that has to be honest. An idle micro-VM actor costs ~180MB of real RSS --
    # 6x a gVisor one, and well over the 256Mi it declares once the guest is
    # resident. An earlier run advertised 30Gi on a 16GB node and the kubelet
    # evicted the worker at 70 actors holding 12.5GB.
    #
    # So the limit is set to what the NODE can really back, not to what the
    # declarations add up to. 300Gi against the node's ~332GiB allocatable
    # keeps the ceiling inside the pod, where hitting it fails an activation
    # instead of evicting the worker mid-run.
    #
    # That admits 1200 actors, and 1200 is then the ceiling for a REASON worth
    # recording: the declaration, not the machine. Measured, a micro-VM actor
    # holds ~88MB, so 1200 of them is ~106GB of a 332GiB node -- the scheduler
    # is refusing placements the hardware would take three times over. The
    # declaration cannot go lower either: the API floors a micro-VM actor at
    # 256Mi (128Mi VMM reserve + 128Mi guest minimum), below which the VM will
    # not boot. Closing the gap between 256Mi declared and 88MB resident is
    # what would raise micro-VM density, and it is a platform change rather
    # than a fixture one.
    resources:
      limits:
        cpu: "600"
        memory: 300Gi
      requests:
        cpu: "2"
        memory: 4Gi

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: tiny-microvm
  namespace: ate-scale-tiny-microvm
spec:
  sandboxClass: microvm
  containers:
  - name: tiny
    image: ko://github.com/agent-substrate/substrate/demos/tiny
    command:
    - /ko-app/tiny
    readyz:
      httpGet:
        path: /readyz
        port: 80
      # A cold guest boot is not a gVisor sandbox start. The gVisor fixture
      # leaves this at the ateom's default; here the first boot has a kernel to
      # get through.
      timeoutSeconds: 120

  # CPU matches the gVisor fixture at 500m so activation latency is comparable.
  # Memory does not and cannot: 56Mi is a plausible process, not a plausible
  # guest, and the limit here sizes the VM's RAM.
  resources:
    limits:
      cpu: 500m
      memory: 256Mi

  workerSelector:
    matchLabels:
      workload: tiny-microvm

  # No volumes, matching the gVisor fixture: this measures the floor.
  snapshotsConfig:
    onPause: Full
    location: gs://${BUCKET_NAME}/ate-scale-tiny-microvm/

