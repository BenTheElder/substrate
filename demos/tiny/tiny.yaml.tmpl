# Density fixture: ONE worker pod, as many Actors on it as will fit.
#
# Everything here is shaped to measure how many Actors a single worker can hold
# and what the Nth activation costs, so it deliberately differs from the other
# demos: one replica (density is per worker, not per pool), a huge per-worker
# envelope, tiny per-Actor declarations, and an Actor with no volumes.
#
# It targets a dedicated tainted node pool so a few thousand Actors cannot
# disturb anything else on the cluster, and nothing else can land on the node
# and skew the measurement.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-scale-tiny

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: tiny
  namespace: ate-scale-tiny
  labels:
    workload: tiny
spec:
  # ONE worker. The question is how many Actors fit on a single worker, so a
  # second replica would only split the population and hide the ceiling.
  replicas: 1

  # What the whole exercise turns on. Admission is per dimension against the
  # worker's capacity, so this is the number that decides when the scheduler
  # stops placing -- and it is the constant that was raised from 64 for exactly
  # this. Set at the addressing ceiling so the scheduler is never the first
  # thing to say no: the point is to find out what actually binds.
  maxActorsPerWorker: 4094

  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor
  template:
    # Keep the density test to itself, in both directions.
    nodeSelector:
      substrate-scale: density
    tolerations:
    - key: substrate-scale
      operator: Equal
      value: density
      effect: NoSchedule

    # Capacity and placement are deliberately DECOUPLED here, which is the only
    # way to probe the addressing ceiling without renting a machine to match.
    #
    # workerCapacity reads the LIMITS only, while the kube-scheduler places by
    # the REQUESTS -- and limits are never checked against node capacity. So the
    # requests are sized to fit beside the system daemons on this node, and the
    # limits advertise the envelope needed to admit ~4000 Actors: 4094 x 500m is
    # just over 2047 cores, so 2100 keeps CPU from being what says no.
    #
    # That is honest rather than a trick, because the declarations are what the
    # scheduler subtracts and the measured reality is far smaller: ~30MB and
    # ~0 CPU per idle Actor, so 4000 of them is ~120GB and almost no CPU on a
    # node with 240GB and 32 cores. The memory LIMIT is still set below node
    # allocatable on purpose: if the measurement is wrong and usage runs away,
    # this pod gets OOM-killed and the node survives.
    resources:
      limits:
        # Sized so the ACTOR's cpu limit is never what caps occupancy: 4094 of
        # them at the 2000m tiny-fast declares. That is a declaration, not a
        # reservation -- an idle actor draws nothing, and only the actors
        # restoring at once spend anything -- which is the same reasoning the
        # memory limit above rests on, and why a 32-core node carries it.
        cpu: "8200"
        memory: 220Gi
      requests:
        cpu: "4"
        memory: 100Gi

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: tiny
  namespace: ate-scale-tiny
spec:
  containers:
  - name: tiny
    image: ko://github.com/agent-substrate/substrate/demos/tiny
    command:
    - /ko-app/tiny
    readyz:
      httpGet:
        path: /readyz
        port: 80

  # The denominator, set from MEASUREMENT rather than guesswork: an idle Actor
  # of this template costs ~30MB of real RSS, so 56Mi is a realistic declaration
  # with headroom. It is what decides where the run stops, because admission is
  # per dimension: 220Gi / 56Mi = ~4022, just under the 4094 the pod-side /20 can
  # number. Whichever of the two says no first is the finding.
  #
  # CPU is the ACTIVATION dial, not a steady-state cost: an idle Actor draws
  # nothing, but a restore is ~0.85 core-seconds of real work, so the limit
  # divides straight into activation latency -- 100m means ~8.5s per restore,
  # 500m means ~1.7s. (10m is the cgroup floor and is NOT usable: readyz times
  # out and even runsc delete gets killed.) Density does not pay for the higher
  # limit, because the worker's CPU limit is a declaration and 4094 x 500m is
  # only ever real if they all restore at once -- concurrency, not occupancy, is
  # what spends it.
  resources:
    limits:
      cpu: 500m
      memory: 56Mi

  workerSelector:
    matchLabels:
      workload: tiny

  # No durable volume and no data snapshot: this measures the floor, and a
  # per-Actor volume would add storage to what is meant to be a memory and
  # namespace measurement.
  snapshotsConfig:
    onPause: Full
    location: gs://${BUCKET_NAME}/ate-scale-tiny/

---

# The same actor with 4x the CPU, to separate "a restore is expensive" from "a
# restore is being throttled".
#
# Measured on a full worker: an actor's own cgroup stalls on its quota for 2.28s
# of an ~11.8s activation, and 30.8% of its scheduling periods are throttled --
# while the node itself sits at 5-16% of 32 cores. So the limit, not the
# machine, is what the restore is waiting for. A restore is ~0.85 core-seconds
# of real work, which at 500m cannot finish in under 1.7s however idle the node
# is.
#
# CPU is an ACTIVATION dial, not a steady-state cost: an idle actor draws
# nothing, so the worker's declared CPU only has to cover the actors restoring
# at once, not all of them. That is why the pool can advertise far less CPU
# than 4094 x 2000m and still admit a full worker.
#
# A separate template rather than an edit, because an ActorTemplate spec is
# immutable -- the size is baked into its snapshots -- and because having both
# side by side is what makes the comparison a comparison.

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: tiny-fast
  namespace: ate-scale-tiny
spec:
  containers:
  - name: tiny
    image: ko://github.com/agent-substrate/substrate/demos/tiny
    command:
    - /ko-app/tiny
    readyz:
      httpGet:
        path: /readyz
        port: 80

  resources:
    limits:
      cpu: "2"
      memory: 56Mi

  # The same pool as tiny: the point is to change one thing.
  workerSelector:
    matchLabels:
      workload: tiny

  snapshotsConfig:
    onPause: Full
    location: gs://${BUCKET_NAME}/ate-scale-tiny-fast/
