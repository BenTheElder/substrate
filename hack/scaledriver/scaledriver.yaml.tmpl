# Runs hack/scaledriver against the density fixture in demos/tiny.
#
# In-cluster because atelet requires a client certificate chaining to the
# podidentity CA, and only a pod can project one.

apiVersion: v1
kind: ServiceAccount
metadata:
  name: scaledriver
  namespace: ${POOL_NS}

---

# Reads only: the ActorTemplate to build the workload spec from, and the pods
# that locate the worker and the atelet beside it. Everything the driver
# actually does happens over the atelet gRPC connection, not the Kubernetes API.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: scaledriver
rules:
- apiGroups: [""]
  resources: ["pods"]
  verbs: ["list"]
- apiGroups: ["ate.dev"]
  resources: ["actortemplates"]
  verbs: ["get"]
# --via=ateapi verifies the server against the servicedns trust bundle before it
# will send a bearer token over the connection, which is a cluster-scoped read.
- apiGroups: ["certificates.k8s.io"]
  resources: ["clustertrustbundles"]
  verbs: ["list"]

---

apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: scaledriver
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: scaledriver
subjects:
- kind: ServiceAccount
  name: scaledriver
  namespace: ${POOL_NS}

---

apiVersion: v1
kind: Pod
metadata:
  name: scaledriver
  namespace: ${POOL_NS}
spec:
  serviceAccountName: scaledriver
  # One shot: the run either finishes or reports what stopped it. A restart
  # would re-activate actors that are already up and hide the ceiling.
  restartPolicy: Never
  # No toleration for the density taint on purpose -- the driver stays off the
  # node it is measuring.
  containers:
  - name: scaledriver
    image: ko://github.com/agent-substrate/substrate/hack/scaledriver
    args:
    - --mode=${MODE}
    - --via=${VIA}
    - --pool-namespace=${POOL_NS}
    - --pool-name=${POOL_NAME}
    - --template-namespace=${TEMPLATE_NS}
    - --template-name=${TEMPLATE_NAME}
    - --atespace=${ATESPACE}
    - --count=${COUNT}
    - --parallel=${PARALLEL}
    - --name-prefix=${NAME_PREFIX}
    - --readyz-timeout-seconds=${READYZ_TIMEOUT_SECONDS}
    - --golden-snapshot-uri=${GOLDEN_SNAPSHOT_URI}
    volumeMounts:
    - name: podidentity
      mountPath: /run/podidentity.podcert.ate.dev
      readOnly: true
    - name: ate-token
      mountPath: /var/run/secrets/ate
      readOnly: true
  volumes:
  # --via=atelet presents this as a client certificate; --via=ateapi does not
  # use it. Both are projected either way so one image covers both paths.
  - name: ate-token
    projected:
      sources:
      - serviceAccountToken:
          path: token
          audience: api.ate-system.svc
          expirationSeconds: 3600
  - name: podidentity
    projected:
      sources:
      - podCertificate:
          signerName: podidentity.podcert.ate.dev/identity
          keyType: ECDSAP256
          credentialBundlePath: credential-bundle.pem
      - clusterTrustBundle:
          signerName: podidentity.podcert.ate.dev/identity
          labelSelector:
            matchLabels:
              podcert.ate.dev/canarying: live
          path: trust-bundle.pem
